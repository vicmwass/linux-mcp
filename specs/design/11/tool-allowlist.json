{
  "schema_version": "linux-mcp/workflow-tool-allowlist/v1",
  "status": "provisional",
  "note": "Tool IDs and argument names for specs 08-10 are provisional until their contract extensions are frozen; a template referencing a tool that is not listed here and registered by the MCP service is rejected. A tool name discovered at runtime is not evidence of a compatible schema. execute_command and any raw-shell tool are never allowed.",
  "denied_tools": [
    "execute_command"
  ],
  "tools": [
