{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditQuery",
  "description": "`GET /api/v1/audit?server_id=&operation_id=&since=&until=&cursor=&limit=`.",
  "type": "object",
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "$ref": "#/$defs/PageLimit",
      "default": 50
    },
    "operation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "server_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ServerId"
        },
        {
          "type": "null"
        }
      ]
    },
    "since": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "until": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "OperationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "PageCursor": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "PageLimit": {
      "type": "integer",
      "default": 50,
      "maximum": 200,
      "minimum": 1
    },
    "ServerId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
