{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PutCredentialRequest",
  "description": "`PUT /api/v1/servers/{server_id}/credentials` — provision or rotate one credential slot.",
  "type": "object",
  "properties": {
    "credential": {
      "$ref": "#/$defs/CredentialInput"
    },
    "expected_revision": {
      "$ref": "#/$defs/ServerRevision"
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_revision",
    "credential"
  ],
  "$defs": {
    "CredentialInput": {
      "description": "Credential to provision or rotate.",
      "oneOf": [
        {
          "description": "OpenSSH private key text. Passphrase-protected keys are not accepted in v1.",
          "type": "object",
          "properties": {
            "private_key": {
              "$ref": "#/$defs/WriteOnlySecret"
            },
            "type": {
              "type": "string",
              "const": "ssh_private_key"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "private_key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "password": {
              "$ref": "#/$defs/WriteOnlySecret"
            },
            "type": {
              "type": "string",
              "const": "sudo_password"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "password"
          ]
        },
        {
          "description": "Use `sudo -n`; removes any stored sudo password.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "sudo_passwordless"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "ServerRevision": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "WriteOnlySecret": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 1,
      "writeOnly": true
    }
  }
}
