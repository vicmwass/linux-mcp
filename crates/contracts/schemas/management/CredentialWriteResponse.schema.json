{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialWriteResponse",
  "description": "Response to credential writes: status and references only.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/CredentialWriteAction"
    },
    "credential": {
      "$ref": "#/$defs/CredentialStatus"
    },
    "server_id": {
      "$ref": "#/$defs/ServerId"
    },
    "server_revision": {
      "description": "New server revision; credential changes invalidate pooled sessions and approvals.",
      "$ref": "#/$defs/ServerRevision"
    }
  },
  "additionalProperties": false,
  "required": [
    "server_id",
    "server_revision",
    "action",
    "credential"
  ],
  "$defs": {
    "CredentialId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "CredentialKind": {
      "type": "string",
      "enum": [
        "ssh_private_key",
        "sudo_password"
      ]
    },
    "CredentialState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "missing",
            "provisioned"
          ]
        },
        {
          "description": "Sudo without a password (`sudo -n`) is configured; no secret is stored.",
          "type": "string",
          "const": "not_required"
        }
      ]
    },
    "CredentialStatus": {
      "description": "Status and reference of one credential slot. Never includes secret material.",
      "type": "object",
      "properties": {
        "credential_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/CredentialKind"
        },
        "state": {
          "$ref": "#/$defs/CredentialState"
        },
        "updated_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "state"
      ]
    },
    "CredentialWriteAction": {
      "type": "string",
      "enum": [
        "provisioned",
        "rotated",
        "removed"
      ]
    },
    "ServerId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ServerRevision": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
