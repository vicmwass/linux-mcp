{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageRequest",
  "description": "Query parameters for any list operation (`?cursor=…&limit=…`).",
  "type": "object",
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "$ref": "#/$defs/PageLimit",
      "default": 50
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PageCursor": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "PageLimit": {
      "type": "integer",
      "default": 50,
      "maximum": 200,
      "minimum": 1
    }
  }
}
