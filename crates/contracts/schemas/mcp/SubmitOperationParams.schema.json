{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubmitOperationParams",
  "description": "`submit_operation` input. The approval ID only *references* an approval; authority is\nminted server-side by atomic consume, so a guessed or foreign ID grants nothing.",
  "type": "object",
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalId"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "$ref": "#/$defs/OperationId"
    }
  },
  "additionalProperties": false,
  "required": [
    "operation_id"
  ],
  "$defs": {
    "ApprovalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "OperationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
